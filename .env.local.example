# Copy this file to .env.local (which is gitignored) and fill in real values.
# Consumed by publish.bat. KEY=VALUE, one per line; lines starting with # are ignored.

# npm automation token — create at https://www.npmjs.com/settings/<user>/tokens
# Must have publish rights to the @testhide scope/org (package is published with --access public).
NPM_TOKEN=npm_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
